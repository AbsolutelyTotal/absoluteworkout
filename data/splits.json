[
  {
    "id": "core-3",
    "name": "3-Day Core Split",
    "daysPerWeek": 3,
    "description": "Default rotation. Push, pull, legs — each with its own core modality.",
    "defaultTempo": "3:1:2:1",
    "cycle": ["push", "pull", "legs"],
    "days": [
      {
        "id": "push",
        "name": "Push & Anti-Rotation Core",
        "shortName": "Push",
        "focus": ["chest", "shoulders", "triceps", "core"],
        "notes": "1-2 warm-up sets at 60-75% before the incline press. Every rep at 3:1:2:1.",
        "blocks": [
          {
            "name": "Chest",
            "items": [
              { "exerciseId": "incline-db-press", "sets": 3, "reps": "6-8", "tempo": "3:1:2:1", "restSeconds": 150 },
              { "exerciseId": "machine-chest-press", "sets": 3, "reps": "8-10", "tempo": "3:1:2:1", "restSeconds": 120 }
            ]
          },
          {
            "name": "Shoulders",
            "items": [
              { "exerciseId": "machine-shoulder-press", "sets": 2, "reps": "8-10", "tempo": "3:1:2:1", "restSeconds": 120 },
              { "exerciseId": "seated-db-lateral-raise", "sets": 3, "reps": "10-15", "tempo": "3:1:2:1", "restSeconds": 75 }
            ]
          },
          {
            "name": "Triceps",
            "items": [
              { "exerciseId": "overhead-rope-extension", "sets": 2, "reps": "10-15", "tempo": "3:1:2:1", "restSeconds": 75 },
              { "exerciseId": "tricep-pushdown", "sets": 2, "reps": "12-15", "tempo": "3:1:2:1", "restSeconds": 60 }
            ]
          },
          {
            "name": "Core — anti-rotation",
            "items": [
              { "exerciseId": "pallof-press", "sets": 3, "reps": "10-12 per side", "restSeconds": 60, "notes": "Anti-rotation. The work is in not moving." }
            ]
          }
        ]
      },
      {
        "id": "pull",
        "name": "Pull & Anti-Extension Core",
        "shortName": "Pull",
        "focus": ["back", "rear-delts", "biceps", "core"],
        "notes": "1-2 warm-up sets before the first pulling movement. Every rep at 3:1:2:1.",
        "blocks": [
          {
            "name": "Back",
            "items": [
              { "exerciseId": "lat-pulldown", "sets": 3, "reps": "6-10", "tempo": "3:1:2:1", "restSeconds": 150, "notes": "Neutral or wide grip. Assisted pull-ups are an equal swap." },
              { "exerciseId": "chest-supported-row", "sets": 3, "reps": "8-10", "tempo": "3:1:2:1", "restSeconds": 120 }
            ]
          },
          {
            "name": "Rear delts",
            "items": [
              { "exerciseId": "chest-supported-rear-delt-fly", "sets": 3, "reps": "10-15", "tempo": "3:1:2:1", "restSeconds": 75, "notes": "Reverse pec deck is an equal swap." }
            ]
          },
          {
            "name": "Biceps",
            "items": [
              { "exerciseId": "incline-db-curl", "sets": 3, "reps": "10-15", "tempo": "3:1:2:1", "restSeconds": 75 }
            ]
          },
          {
            "name": "Core — anti-extension",
            "items": [
              { "exerciseId": "straight-arm-cable-pushdown", "sets": 3, "reps": "10-12", "tempo": "3:1:2:1", "restSeconds": 60, "notes": "Anti-extension core and lat finisher in one." }
            ]
          }
        ]
      },
      {
        "id": "legs",
        "name": "Legs & Core Stability",
        "shortName": "Legs",
        "focus": ["quads", "hamstrings", "glutes", "core"],
        "notes": "Two isolations first, then the compound. Leg press stops at 90° knee flexion — no exceptions.",
        "blocks": [
          {
            "name": "Isolation",
            "items": [
              { "exerciseId": "seated-hamstring-curl", "sets": 3, "reps": "12-15", "tempo": "3:1:2:1", "restSeconds": 90 },
              { "exerciseId": "leg-extension", "sets": 3, "reps": "12-15", "tempo": "3:1:2:1", "restSeconds": 90 }
            ]
          },
          {
            "name": "Compound",
            "items": [
              { "exerciseId": "seated-horizontal-leg-press", "sets": 3, "reps": "8-10", "tempo": "3:1:2:1", "restSeconds": 150, "notes": "Max 90° knee flexion. Going deeper rounds the lumbar spine." },
              { "exerciseId": "single-leg-glute-bridge", "sets": 3, "reps": "10-12 per side", "tempo": "3:1:2:1", "restSeconds": 75, "notes": "Replaces the RDL — hip extension without spinal shear." }
            ]
          },
          {
            "name": "Core — anti-lateral flexion",
            "items": [
              { "exerciseId": "side-plank-knee-modified", "sets": 3, "reps": "20-30s per side", "restSeconds": 60, "notes": "Half-kneeling Pallof press is an equal swap." }
            ]
          }
        ]
      }
    ]
  },
