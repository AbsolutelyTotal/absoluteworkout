# macOS
.DS_Store

# Claude Code local config (machine-specific)
.claude/

# Editors
.vscode/
.idea/

# Logs
*.log

# Exported workout logs — these contain bodyweight and training data.
# Keep backups outside the repo, especially if it ever goes public.
absoluteworkout-*.json

# API keys must never land in this repo — it is public. Keys go in the shell
# environment for the session only, never in a file. See tools/gen-images.mjs.
*.key
.env
.env.*
**/gemini-key*

# Wrangler local state/cache (holds the CF account id + account email — never commit)
.wrangler/
# Node deps if ever installed locally
node_modules/
